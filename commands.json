    {
      "category": "Active Directory",
      "name": "Copy groups from another user",
      "description": "Adds the target user to every group the source user is in. Leave Preview ticked to see the list first.",
      "confirm": true,
      "requires": "ActiveDirectory PowerShell module (RSAT) and an account with rights to make the change",
      "parameters": [
        {
          "name": "SourceUser",
          "label": "Copy from",
          "required": true,
          "hint": "Existing user, e.g. jsmith"
        },
        {
          "name": "TargetUser",
          "label": "Copy to",
          "required": true,
          "hint": "New or target user"
        },
        {
          "name": "Preview",
          "kind": "Switch",
          "default": "true",
          "hint": "Preview only (make no changes)"
        }
      ],
      "script": [
        "Import-Module ActiveDirectory -ErrorAction Stop",
        "",
        "$src = @((Get-ADUser -Identity $SourceUser -Properties MemberOf -ErrorAction Stop).MemberOf)",
        "$dst = @((Get-ADUser -Identity $TargetUser -Properties MemberOf -ErrorAction Stop).MemberOf)",
        "$missing = @($src | Where-Object { $_ -notin $dst })",
        "if ($missing.Count -eq 0) { \"$TargetUser is already in all of $SourceUser's groups.\"; return }",
        "foreach ($dn in $missing) {",
        "    $g = Get-ADGroup -Identity $dn",
        "    if ($Preview) { \"Would add: $($g.Name)\" }",
        "    else { Add-ADGroupMember -Identity $g -Members $TargetUser -ErrorAction Continue; \"Added: $($g.Name)\" }",
        "}",
        "if ($Preview) { \"`n$($missing.Count) group(s). Untick Preview and run again to apply.\" }",
        ""
      ]
    },
    {
      "category": "Active Directory",
      "name": "Inactive accounts",
      "description": "Users or computers that haven't logged on in N days (based on lastLogonTimestamp, accurate to ~14 days).",
      "requires": "ActiveDirectory PowerShell module (RSAT)",
      "parameters": [
        {
          "name": "Type",
          "kind": "Choice",
          "options": [
            "Computers",
            "Users"
          ],
          "default": "Computers"
        },
        {
          "name": "Days",
          "label": "Inactive for (days)",
          "kind": "Number",
          "default": "90"
        }
      ],
      "script": [
        "Import-Module ActiveDirectory -ErrorAction Stop",
        "",
        "$p = @{ AccountInactive = $true; TimeSpan = (New-TimeSpan -Days $Days); ErrorAction = 'Stop' }",
        "if ($Type -eq 'Computers') { $p.ComputersOnly = $true } else { $p.UsersOnly = $true }",
        "$a = @(Search-ADAccount @p)",
        "$a | Sort-Object LastLogonDate | Select-Object Name, SamAccountName, Enabled, LastLogonDate, DistinguishedName | Format-Table -AutoSize",
        "\"$($a.Count) inactive $($Type.ToLower()).\"",
        ""
      ]
    }
  ]
